# Cup Racing Analysis Tool — environment config
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# OpenRouter API key (https://openrouter.ai/keys). Required for `buddy chat`.
OPENROUTER_API_KEY=

# Model slug. You can paste an OpenRouter slug straight off openrouter.ai —
# a bare "provider/model" is automatically routed through OpenRouter, so both
# of these are equivalent:
#   anthropic/claude-3.5-sonnet
#   openrouter/anthropic/claude-3.5-sonnet
# Others: google/gemini-2.0-flash-001, openai/gpt-4o, deepseek/deepseek-v4-flash
BUDDY_MODEL=anthropic/claude-3.5-sonnet

# Optional OpenRouter traffic attribution (shows on your OpenRouter dashboard):
# OPENROUTER_REFERER=https://localhost/cup-racing-analysis-tool
# OPENROUTER_TITLE=Cup Racing Analysis Tool

# Optional overrides (sensible defaults derived from the project layout).
# BUDDY_API_BASE only needed for a proxy/gateway; OpenRouter base is automatic.
# BUDDY_API_BASE=
# BUDDY_DATA=data/Cup_Racing_Complete_Data.md
# BUDDY_DB=output/cup_racing.duckdb
# BUDDY_MAX_TOOL_ITERS=12
# BUDDY_SQL_ROW_CAP=200

# Retries for transient upstream failures (OpenRouter routing to a flaky provider,
# most often a stream that dies mid-answer). Set BUDDY_MAX_RETRIES=0 to disable.
# Backoff is exponential with jitter: base * 2^(attempt-1), capped at max.
# BUDDY_MAX_RETRIES=3
# BUDDY_RETRY_BASE_DELAY=1.0
# BUDDY_RETRY_MAX_DELAY=15.0
# Force a tool call before the first reply of each turn (grounding backstop).
# On by default; set to 0 to let the model decide when to use tools.
# BUDDY_FORCE_FIRST_TOOL=1
